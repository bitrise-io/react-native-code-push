// Compiles src/ -> lib/: the actual runtime code this package ships to consumers. Run via `npm run build:ts`.

// This is a separate config from tsconfig.json because that one only type-checks test/ (no emit)
// and has a different audience (the mocha test suite) than what we publish to consumers.
//
// TODO: once the rest of this repo's runtime JS (CodePush.js, etc.) is migrated to TypeScript,
// this and tsconfig.json should be unified into a single project.
{
    "compilerOptions": {
        "target": "es2019",
        "module": "commonjs",
        // A subset of what RN supports at the oldest supported version (0.76). Widen it only as far as RN's list:
        // https://github.com/facebook/react-native/blob/0.76-stable/packages/typescript-config/tsconfig.json
        "lib": ["es2019"],
        // Only RN's globals (console, fetch, etc.). Other ambient @types/* (e.g. Node) would add their own libs,
        // and the list above would not be enforced.
        "types": ["react-native"],
        // RN's own .d.ts files do not type-check standalone (as in @react-native/typescript-config).
        "skipLibCheck": true,
        "declaration": true,
        "strict": true,
        // TODO: existing legacy code is not null-safe, fix one day.
        "strictNullChecks": false,
        "noEmitOnError": true,
        "moduleResolution": "bundler",
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "lib",
        "removeComments": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/__tests__/**"]
}
