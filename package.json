{
  "name": "@bitrise/code-push-sdk",
  "version": "0.0.0",
  "description": "React Native plugin for the CodePush service",
  "main": "CodePush.js",
  "typings": "typings/react-native-code-push.d.ts",
  "homepage": "https://github.com/bitrise-io/react-native-code-push",
  "keywords": [
    "react-native",
    "code",
    "push",
    "expo"
  ],
  "author": "Bitrise",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.3.0",
      "onFail": "error"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "typescript"
    ]
  },
  "scripts": {
    "setup": "npm install --quiet --no-progress && npm run build:ts",
    "build:ts": "bob build",
    "prepare": "npm run build:ts",
    "check:api-compat": "tsc -p api-compat/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "npm run tslint && tsc -p test/tsconfig.json",
    "test": "npm run typecheck:tests && npm run test:setup && npm run test:fast",
    "test:android": "npm run typecheck:tests && npm run test:setup:android && npm run test:fast:android",
    "test:ios": "npm run typecheck:tests && npm run test:setup:ios && npm run test:fast:ios",
    "test:expo:android": "npm run typecheck:tests && npm run test:setup:expo:android && npm run test:fast:expo:android",
    "test:expo:ios": "npm run typecheck:tests && npm run test:setup:expo:ios && npm run test:fast:expo:ios",
    "test:setup": "mocha --extension mts --recursive test --android --ios --setup",
    "test:setup:android": "mocha --extension mts --recursive test --android --setup",
    "test:setup:ios": "mocha --extension mts --recursive test --ios --setup",
    "test:setup:expo:android": "mocha --extension mts --recursive test --android --setup --expo",
    "test:setup:expo:ios": "mocha --extension mts --recursive test --ios --setup --expo",
    "test:fast": "mocha --extension mts --recursive --bail test --android --ios",
    "test:fast:android": "mocha --extension mts --recursive --bail test --android",
    "test:fast:ios": "mocha --extension mts --recursive --bail test --ios",
    "test:fast:expo:android": "mocha --extension mts --recursive --bail test --android --expo",
    "test:fast:expo:ios": "mocha --extension mts --recursive --bail test --ios --expo",
    "test:debugger:android": "mocha --extension mts --recursive --inspect-brk=0.0.0.0 test --android",
    "test:debugger:ios": "mocha --extension mts --recursive --inspect-brk=0.0.0.0 test --ios",
    "test:unit:android": "cd android && ./gradlew :app:test",
    "test:unit:ios": "xcodebuild test -project ios/CodePush.xcodeproj -scheme CodePushTests -destination \"platform=iOS Simulator,id=$(xcrun simctl list devices available | grep -m1 iPhone | grep -oE '[0-9A-F-]{36}')\"",
    "tslint": "tslint -c tslint.json test/**/*.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bitrise-io/react-native-code-push"
  },
  "dependencies": {
    "hoist-non-react-statics": "^3.3.2"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.87.1",
    "@types/assert": "^1.5.2",
    "@types/mkdirp": "^1.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/q": "^1.5.4",
    "archiver": "latest",
    "body-parser": "latest",
    "code-push-plugin-testing-framework": "file:./code-push-plugin-testing-framework",
    "del": "v6.0.0",
    "express": "latest",
    "mkdirp": "latest",
    "mocha": "^12.0.2",
    "q": "^1.5.1",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.1",
    "run-sequence": "latest",
    "slash": "^3.0.0",
    "tslint": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
