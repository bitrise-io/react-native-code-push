// Type-checks the library sources in src/. `npm run typecheck` runs it directly with --noEmit;
// `npm run build:ts` (react-native-builder-bob) reuses it to generate the .d.ts files, and compiles
// the JS with Babel (see babel.config.js).
//
// The mocha integration tests in test/ have their own config: test/tsconfig.json.
{
    "compilerOptions": {
        "target": "es2019",
        "module": "commonjs",
        // A subset of what RN supports at the oldest supported version (0.76). Widen it only as far as RN's list:
        // https://github.com/facebook/react-native/blob/0.76-stable/packages/typescript-config/tsconfig.json
        "lib": ["es2019"],
        // Only RN's globals (console, fetch, etc.). Other ambient @types/* (e.g. Node) would add their own libs,
        // and the list above would not be enforced.
        "types": ["react-native"],
        // RN's own .d.ts files do not type-check standalone (as in @react-native/typescript-config).
        "skipLibCheck": true,
        "strict": true,
        // TODO: existing legacy code is not null-safe, fix one day.
        "strictNullChecks": false,
        "moduleResolution": "bundler",
        // Babel compiles the JS, so the compiler must not choke on syntax that needs whole-program information.
        "isolatedModules": true,
        "noEmit": true,
        "rootDir": "src"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/__tests__/**"]
}
